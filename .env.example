# Copy this file to .env and fill in the values.
# Secrets go in Cloudflare (Worker → Settings → Variables and Secrets) for deployed use.
# Local runs (npm run dev) read .dev.vars, which uses the same names.

# Secret: from @BotFather
TELEGRAM_BOT_TOKEN=
# Secret: any long random string (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
# Secret: Supabase Settings → API → service_role
SUPABASE_SERVICE_KEY=

# Plain values: Supabase Settings → API → Project URL
SUPABASE_URL=
# Plain value: your numeric Telegram user ID from @userinfobot
ALLOWED_CHAT_ID=

# Fallback timezone when none is saved in the database
DIARY_TZ=Europe/Paris
